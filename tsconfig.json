{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "types",
    "rootDir": "src",
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["src/**/*.test.js"]
}
